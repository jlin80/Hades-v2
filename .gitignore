# --- Secrets -----------------------------------------------------------------
# Never commit a real .env. Only .env.example is tracked.
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# --- Tooling caches ----------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# --- Docker / local runtime --------------------------------------------------
# docker-compose.override.yml is auto-loaded by Docker Compose. In Hades v1 a
# committed override silently ran production in development mode for weeks.
# It stays untracked on purpose: it is a local-only escape hatch.
docker-compose.override.yml

# --- Editors / OS ------------------------------------------------------------
.idea/
.vscode/
*.swp
Thumbs.db
desktop.ini
