# Hades V2 — configuration template.
#
#   cp .env.example .env
#
# Copy this file to .env and adjust. .env is gitignored and must never be
# committed. Every variable below is documented; nothing important is hardcoded
# anywhere in the source tree (task.md §15).
#
# This file is consumed by two different readers:
#
#   * the application  -> variables under "APPLICATION", parsed by
#                         hades.config.settings.Settings
#   * Docker Compose   -> variables under "DOCKER COMPOSE ONLY", used for
#                         ${VAR} substitution in docker-compose.yml
#
# tests/test_config.py asserts both directions stay in sync: an application
# setting missing from this file fails the suite, and a variable documented here
# that nothing consumes fails it too. Hades v1 shipped a fully documented
# SCORING_* namespace wired to nothing, visible in the dashboard, silently
# doing nothing when an operator changed it. That cannot recur silently here.


# =============================================================================
# APPLICATION
# =============================================================================

# Deployment environment: development | production
# Affects log defaults only. It never enables or disables business logic.
ENVIRONMENT=development

# Async PostgreSQL DSN. Must use the postgresql+asyncpg:// scheme; a sync
# driver URL is rejected at startup rather than failing on first query.
#
# NOTE: when running via docker compose this value is IGNORED. The compose file
# builds the DSN from the POSTGRES_* variables below and points it at the
# `postgres` service. The value here is for running the app or tests directly
# on your workstation against a database reachable on localhost.
DATABASE_URL=postgresql+asyncpg://hades:change_me_locally@localhost:5432/hades

# SQLAlchemy connection pool.
# db_pool_size    : persistent connections kept open.
# db_max_overflow : extra connections allowed beyond the pool under load.
# Keep the total (pool + overflow) per process well under PostgreSQL's
# max_connections. Hades v1 exhausted its pool because several dashboard
# pollers each ran the same 36-second query concurrently.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Seconds to wait when establishing a new database connection.
DB_CONNECT_TIMEOUT_SECONDS=10

# Minimum severity emitted: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log rendering: json | console
# Use json everywhere that logs are collected; console is for local reading.
LOG_FORMAT=json

# Address and port the API binds to inside its own process/container.
# 0.0.0.0 is correct inside a container; the published port is controlled by
# API_PUBLISHED_PORT below.
API_HOST=0.0.0.0
API_PORT=8000


# =============================================================================
# DOCKER COMPOSE ONLY
# =============================================================================
# Consumed by docker-compose.yml for ${VAR} substitution. The application never
# reads these directly.

# PostgreSQL credentials. The compose file builds the application's DATABASE_URL
# from these, so they are the single source of truth when running in Docker.
# Generate a real password for anything that is not a throwaway local stack:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_USER=hades
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=hades

# Host port for PostgreSQL. Published on 127.0.0.1 only, never on the LAN.
# Reach it from a workstation with an SSH tunnel:
#   ssh -L 5432:127.0.0.1:5432 <host>
POSTGRES_PUBLISHED_PORT=5432

# Host port the API is published on.
API_PUBLISHED_PORT=8000

# Tag applied to the built image.
HADES_IMAGE_TAG=0.1.0
