# Hades V2 — Phase 0 configuration.
# Copy to .env and adjust. Every value here is read by hades.config.Settings.

HADES_ENVIRONMENT=local
HADES_LOG_LEVEL=INFO

# Must use the asyncpg driver — a sync driver would block the event loop and
# Settings rejects it at startup.
HADES_DATABASE_URL=postgresql+asyncpg://hades:changeme@localhost:5432/hades
HADES_DATABASE_POOL_SIZE=5
HADES_DATABASE_POOL_MAX_OVERFLOW=5
HADES_DATABASE_CONNECT_TIMEOUT_SECONDS=5.0

HADES_API_HOST=0.0.0.0
HADES_API_PORT=8000

# --- Discovery (Phase 2) -----------------------------------------------------
# Off by default: starting the API must not start writing to the database as a
# side effect. Turn it on deliberately.
HADES_DISCOVERY_ENABLED=false
# Not a throughput lever. V1 raised its poll interval 12x and its intake did not
# fall, because the rate tokens appear on Solana is not set by our clock.
HADES_DISCOVERY_POLL_INTERVAL_SECONDS=60
HADES_DISCOVERY_POLL_LIMIT=50
# Tokens per pass whose missing created_at we chase. Deferred, not fetched on
# arrival: the socket announces a mint before pump.fun indexes it, and measured
# live, 49 of 51 immediate fetches returned 404.
HADES_DISCOVERY_BACKFILL_LIMIT=50

HADES_PROVIDER_TIMEOUT_SECONDS=10
HADES_PROVIDER_MAX_ATTEMPTS=3
HADES_PROVIDER_MAX_CONNECTIONS=10

# Consumed by docker-compose for the postgres service.
POSTGRES_USER=hades
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hades
