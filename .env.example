# Hades V2 — Phase 0 configuration.
# Copy to .env and adjust. Every value here is read by hades.config.Settings.

HADES_ENVIRONMENT=local
HADES_LOG_LEVEL=INFO

# Must use the asyncpg driver — a sync driver would block the event loop and
# Settings rejects it at startup.
HADES_DATABASE_URL=postgresql+asyncpg://hades:changeme@localhost:5432/hades
HADES_DATABASE_POOL_SIZE=5
HADES_DATABASE_POOL_MAX_OVERFLOW=5
HADES_DATABASE_CONNECT_TIMEOUT_SECONDS=5.0

HADES_API_HOST=0.0.0.0
HADES_API_PORT=8000

# --- Discovery (Phase 2) -----------------------------------------------------
# Off by default: starting the API must not start writing to the database as a
# side effect. Turn it on deliberately.
HADES_DISCOVERY_ENABLED=false
# Not a throughput lever. V1 raised its poll interval 12x and its intake did not
# fall, because the rate tokens appear on Solana is not set by our clock.
HADES_DISCOVERY_POLL_INTERVAL_SECONDS=60
HADES_DISCOVERY_POLL_LIMIT=50
# Tokens per pass whose missing created_at we chase. Deferred, not fetched on
# arrival: the socket announces a mint before pump.fun indexes it, and measured
# live, 49 of 51 immediate fetches returned 404.
HADES_DISCOVERY_BACKFILL_LIMIT=50
# Attempts before we stop asking about a mint. Some tokens reach the WebSocket
# but never enter pump.fun's index (external launchpads); without a budget they
# occupy the queue forever and starve tokens that are merely not indexed yet.
HADES_DISCOVERY_BACKFILL_MAX_ATTEMPTS=5

# --- Tracking (Phase 3) ------------------------------------------------------
HADES_TRACKING_ENABLED=false
# The binding constraint, not a preference. Measured: the primary sustains
# 1.64 req/s, Pump.fun creates 0.24-0.55 tokens/s, and the schedule costs 434
# snapshots per token per day -- tracking everything needs 64x to 146x capacity.
# 40 concurrent over a 1h horizon is about 1.2 req/s. /status publishes the
# implied rate, so raising this is a visible decision. Redo the arithmetic first.
HADES_TRACKING_MAX_CONCURRENT=40
HADES_TRACKING_BATCH_SIZE=20
HADES_TRACKING_PASS_INTERVAL_SECONDS=2
HADES_TRACKING_REQUEST_SPACING_SECONDS=0.2
HADES_TRACKING_STALE_AFTER_SECONDS=60
HADES_TRACKING_MAX_SNAPSHOT_FAILURES=3
HADES_TRACKING_FAILURE_RETRY_SECONDS=30

# Schedule (spec §8). The intervals are a lower bound, not an achieved rate:
# measured ~12.2s against a 10s target. Features use the stored observed_at, so
# that is harmless -- but do not assume a uniform grid.
HADES_EARLY_TRACKING_SECONDS=300
HADES_EARLY_SNAPSHOT_INTERVAL_SECONDS=10
HADES_MEDIUM_TRACKING_SECONDS=1800
HADES_MEDIUM_SNAPSHOT_INTERVAL_SECONDS=30
HADES_NORMAL_TRACKING_SECONDS=7200
HADES_NORMAL_SNAPSHOT_INTERVAL_SECONDS=60
HADES_LONG_TERM_SNAPSHOT_INTERVAL_SECONDS=300
# One hour: covers every outcome horizon spec §15 asks for, at 110 snapshots per
# token. A 24h horizon costs 4x per token and buys nothing §15 asks for.
HADES_TRACKING_RETIRE_AFTER_SECONDS=3600

# --- Signal research (Phase 5) -----------------------------------------------
# Research signals only. Nothing downstream executes anything.
HADES_SIGNALS_ENABLED=false
HADES_SIGNAL_BATCH_SIZE=25
HADES_SIGNAL_PASS_INTERVAL_SECONDS=5
HADES_SIGNAL_SERIES_LOOKBACK_SECONDS=300
# 0 stores a vector for every new snapshot -- the research ideal. At 40 tracked
# tokens that is ~100k rows/day at ~1 KB each (~100 MB/day), enough to fill a
# homelab rootfs in months. Raise it to thin the dataset deliberately.
HADES_SIGNAL_OBSERVATION_MIN_INTERVAL_SECONDS=0

# EARLY MOMENTUM thresholds (spec §12). Every one is a plausible starting point,
# NOT a value derived from evidence. Measured over a 200s live run,
# market_cap_velocity alone blocked 95% of observations -- it is doing most of
# the gating and nobody has established 0.05 is the right number. First thing
# for Phase 7 to sweep.
HADES_SIGNAL_WINDOW=30s
HADES_SIGNAL_MIN_TOKEN_AGE_SECONDS=30
HADES_SIGNAL_MAX_TOKEN_AGE_SECONDS=300
HADES_SIGNAL_MIN_MARKET_CAP_VELOCITY=0.05
HADES_SIGNAL_MIN_MARKET_CAP_ACCELERATION=0
HADES_SIGNAL_MIN_LIQUIDITY_VELOCITY=0
HADES_SIGNAL_MIN_PRICE_MOVEMENT_RATIO=0.5
HADES_SIGNAL_MAX_SECONDS_SINCE_LAST_TRADE=30
HADES_SIGNAL_MIN_LIQUIDITY_SOL=1.0
HADES_SIGNAL_MIN_OBSERVATIONS=3
HADES_SIGNAL_MAX_FRESHNESS_SECONDS=30

# Optional. Unset means no notifier is built at all -- absent, not degraded.
# A signal is already durable in Postgres the moment it fires; this only
# mirrors it somewhere a human sees it faster than polling /status. A webhook
# outage never affects the signal pipeline -- see src/hades/signals/notify.py.
# HADES_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

HADES_PROVIDER_TIMEOUT_SECONDS=10
HADES_PROVIDER_MAX_ATTEMPTS=3
HADES_PROVIDER_MAX_CONNECTIONS=10

# Consumed by docker-compose for the postgres service.
POSTGRES_USER=hades
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hades
